PORT=5000
MONGODB_URI=mongodb://localhost:27017/file-manager
# External filesystem root for file and folder storage (metadata stays in MongoDB).
STORAGE_ROOT=C:\Uploads
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# Comma-separated browser origins allowed to call the API with cookies.
# Production example (required for https://db.example.com -> https://api.example.com):
# FRONTEND_URL=https://db.example.com
# With COOKIE_CROSS_ORIGIN=true, sibling subdomains on the same domain are also allowed.
FRONTEND_URL=http://localhost:5173,http://192.168.107.48:5173
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-strong-password
NODE_ENV=development
# Trust one reverse-proxy hop (Vite dev proxy or nginx). Required for express-rate-limit with X-Forwarded-For.
TRUST_PROXY=1
# Set to true only for direct cross-origin HTTPS API calls (not needed with Vite proxy).
# COOKIE_CROSS_ORIGIN=false
# Optional total storage display limit for dashboard (bytes). Default: 55GB.
# USER_STORAGE_LIMIT=59055800320
# Reverse proxy: default nginx client_max_body_size is 1m. Uploads over ~1 MB fail
# unless raised to match the app limit. See deploy/nginx-api.conf.example.
# Google Sheets ingest (Apps Script sends X-API-Key header; must match exactly).
# Used by both TBF_LEADS (Facebook) and Apply Now (website) spreadsheets — same secret.
# SHEETS_INGEST_SECRET=choose-a-long-random-string
# Default source when payload omits source (Facebook batch sync). Website payloads send source: Website.
# SHEETS_DEFAULT_LEAD_SOURCE=Facebook
# SHEETS_INGEST_ACTOR_USER_ID=optional-user-id-for-system-comments
# BULK_LEAD_SOURCE is set in Apps Script Script Properties for google-sheets-daily-bulk.gs (e.g. Indeed)
# Slack new-lead notifications (Incoming Webhook for a single channel).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_LEAD_NOTIFICATIONS_ENABLED=true
# RingCentral integration (JWT auth + webhook). All optional — integration disabled if unset.
# RINGCENTRAL_SERVER=https://platform.ringcentral.com
# RINGCENTRAL_CLIENT_ID=
# RINGCENTRAL_CLIENT_SECRET=
# RINGCENTRAL_JWT=
# Full webhook URL (or set RINGCENTRAL_WEBHOOK_BASE_URL=https://api.example.com)
# RINGCENTRAL_WEBHOOK_URL=https://api.example.com/api/webhooks/ringcentral
# RINGCENTRAL_WEBHOOK_VERIFICATION_TOKEN=choose-a-long-random-string
# Registration is restricted to authorized roles. Super Admin is always allowed.
# Set to false to forbid Admins from registering new accounts (Super Admin only).
# ALLOW_ADMIN_REGISTER=true